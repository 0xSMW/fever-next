# Example only. Put real inputs in a private absolute-path file, mode0600.
# CLI requires --env-file explicitly; it never automatically discovers .env.
MIGRATION_DATABASE_URL=postgresql://fever_migrator:replace-password@127.0.0.1:5432/fever
LEGACY_MYSQL_URL=mysql://source_reader:replace-password@127.0.0.1:3306/legacy_fever
ROLLBACK_MYSQL_URL=mysql://rollback_operator:replace-password@127.0.0.1:3306/isolated_restored_fever
FEVER_DB_SSL=false
# For remote verified TLS, FEVER_DB_SSL=true, optional PEM FEVER_DB_SSL_CA,
# and FEVER_PG_SSL_ROOT_CERT=/absolute/private/ca.pem for pg_dump/pg_restore.
FEVER_BASE_URL=https://reader.example.com
NEXTAUTH_URL=https://reader.example.com/api/auth
NEXT_PUBLIC_BASE_PATH=
NEXTAUTH_SECRET=replace-with-the-same-runtime-secret-at-least-32-bytes
FEVER_ENCRYPTION_KEY_ID=primary
FEVER_ENCRYPTION_KEY=replace-with-the-same-runtime-base64-32-byte-key
