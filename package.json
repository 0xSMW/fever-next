{
  "name": "fever-next",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "worker": "node --conditions=react-server --import tsx worker/index.ts",
    "refresh": "node --conditions=react-server --import tsx scripts/fetchFeeds.ts",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "import:legacy": "node --conditions=react-server --import tsx scripts/import-legacy.ts",
    "ops": "node --conditions=react-server --import tsx cli/ops.ts",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:integration": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/database*.test.ts",
    "test:http": "node --conditions=react-server --import tsx --test tests/api-http-contract.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "domutils": "4.0.2",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "htmlparser2": "12.0.0",
    "iconv-lite": "0.7.3",
    "ipaddr.js": "2.5.0",
    "mysql2": "3.24.6",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "re2js": "2.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "saxes": "6.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "1.64.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0",
  "volta": {
    "node": "24.22.1"
  }
}
