# Copy to an untracked .env file. Replace all placeholders before use.
# Runtime: PostgreSQL only. MySQL and SQLite are supported solely as migration sources.
DATABASE_URL=postgresql://fever:replace-with-database-password@127.0.0.1:5432/fever
# Production defaults to verified TLS. Set false only for an explicitly trusted local database.
FEVER_DB_SSL=false
FEVER_DB_POOL_MAX=10

# These three values must describe the same installation path.
FEVER_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000/api/auth
NEXT_PUBLIC_BASE_PATH=
# Supply at least 32 random bytes for the authentication secret.
NEXTAUTH_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
# Bootstrap token is supplied directly to the installation form. Do not place it in URLs.
FEVER_SETUP_TOKEN=replace-with-a-unique-random-bootstrap-token
FEVER_SESSION_MAX_AGE_SECONDS=604800

# Supply a base64-encoded random 32-byte encryption key, and retain it with backups.
FEVER_ENCRYPTION_KEY_ID=primary
FEVER_ENCRYPTION_KEY=
# Rotation alternative: a JSON object mapping key IDs to base64 keys.
# FEVER_ENCRYPTION_KEYS={"primary":"...","previous":"..."}

FEVER_WORKER_CONCURRENCY=4
FEVER_PER_HOST_CONCURRENCY=2
FEVER_WORKER_POLL_MS=5000
FEVER_LEASE_SECONDS=120
FEVER_MAX_JOB_ATTEMPTS=5
FEVER_FETCH_TIMEOUT_MS=20000
FEVER_MAX_FEED_BYTES=8388608
FEVER_MAX_MEDIA_BYTES=10485760
FEVER_MAX_IMPORT_BYTES=16777216
FEVER_MAX_FEED_ITEMS=100
FEVER_MAX_REDIRECTS=4
# Comma-separated exact origins; empty denies private-network fetches.
FEVER_ALLOWED_PRIVATE_ORIGINS=
# Remains disabled until import reconciliation, rehearsal, and cutover approval.
FEVER_RETENTION_ENABLED=false

# Vercel scheduled refresh only; strong independent Bearer secret.
# Use a direct/session-preserving PostgreSQL URL and FEVER_DB_POOL_MAX >= 2.
CRON_SECRET=
